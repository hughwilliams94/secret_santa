# Port to listen on
PORT=3000
# The public address of the site – used in links shown to the organiser and in emails
BASE_URL=https://santa.example.com
# Optional: fix the organiser link (otherwise a random one is generated and printed on startup)
# ADMIN_TOKEN=choose-something-long-and-random

# Optional email (leave SMTP_HOST unset to turn email off)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Secret Santa <you@gmail.com>"
