# Copy to ~/.config/secret-santa/secret-santa.env (rootless)
#      or /etc/secret-santa/secret-santa.env (rootful).
# The SMTP password is NOT kept here – it is a Podman secret (see README).

# Public HTTPS address of the site, used in links and emails
BASE_URL=https://santa.example.com

# Optional: fix the organiser link. If unset, a random one is generated on
# first start and printed in the logs (journalctl --user -u secret-santa).
# ADMIN_TOKEN=change-me-to-something-long-and-random

# Fastmail SMTP (implicit TLS on 465)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=you@fastmail.com
# Must be your Fastmail address or one of your aliases/domains
MAIL_FROM="Secret Santa <you@fastmail.com>"
