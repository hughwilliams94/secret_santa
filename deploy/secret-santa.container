# Quadlet unit for the Secret Santa app.
# Rootless: copy to ~/.config/containers/systemd/
# Rootful:  copy to /etc/containers/systemd/
[Unit]
Description=Family Secret Santa
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=secret-santa
Image=localhost/secret-santa:latest
# Only reachable from the VPS itself; put Caddy/nginx in front for HTTPS.
PublishPort=127.0.0.1:3000:3000
Volume=secret-santa-data.volume:/data
# %E is ~/.config for rootless units and /etc for rootful ones.
EnvironmentFile=%E/secret-santa/secret-santa.env
# Fastmail app password, created with `podman secret create`.
Secret=secret-santa-smtp-pass,type=env,target=SMTP_PASS

ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

HealthCmd=wget -qO- http://127.0.0.1:3000/healthz || exit 1
HealthInterval=5m
HealthStartPeriod=20s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
